    "test": "node --test test/*.test.ts"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
